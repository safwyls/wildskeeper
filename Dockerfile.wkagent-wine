# wkagent, with Wine — for the WKAGENT_LAUNCH_PROFILE=wine launch profile.
#
# Why a second image rather than a build arg on the first: Wine plus its
# 32-bit dependencies adds well over a gigabyte, and the overwhelming
# majority of servers run the native Linux build and will never need it.
# Paying that on every pull, for everyone, to serve the minority that wants
# mods is the wrong default — so the plain image stays small and this one
# exists for the deployments that have chosen the Windows build.
#
# What the extra weight buys: the Windows dedicated server can load UE4SS,
# and UE4SS is the only way the dwbridge mod — and therefore on-demand
# saves and any future command — can reach the game at all.
#
# Build:
#   docker build -f Dockerfile.wkagent-wine -t ghcr.io/safwyls/wkagent:wine .
#
# The mod files still live next to the server exe in the install volume —
# that is data, not image, and Steam updates and operators own it. What this
# image *does* carry is the seed: the pinned-by-proof UE4SS kit at
# /opt/dwbridge-kit (tools/dwbridge-kit/README.md), which the agent copies
# into the install only when the operator asks (POST /v1/bridge/install /
# the dashboard's "Install mod support") and only when no ue4ss/ exists.
# Explicit act, never an overwrite — the version-coupling objection to
# baking applied to silent syncing, not to an installer payload.

# ---- build ----
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/wkagent ./cmd/wkagent

# ---- version.dll shim ----
# Built from source here rather than committed: the source is 200 lines in
# this repo, and mingw makes the build reproducible.
FROM docker.io/library/debian:12-slim AS shim
RUN apt-get update && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*
COPY tools/ue4ss-wine-shim /src
RUN x86_64-w64-mingw32-gcc -shared -O1 -o /version.dll /src/version_proxy.c /src/version.def

# ---- dwbridge kit ----
# Assembled at /opt/dwbridge-kit exactly as it must land next to the server
# exe: the pinned UE4SS tarball (see tools/dwbridge-kit/README.md for why a
# committed binary is the only pin that can't rot), the shim, and the mod
# from this repo — so the mod version always matches the agent it ships with.
FROM docker.io/library/debian:12-slim AS kit
COPY tools/dwbridge-kit/ue4ss-1c1a1497.tar.gz /tmp/
RUN mkdir -p /opt/dwbridge-kit && tar xzf /tmp/ue4ss-1c1a1497.tar.gz -C /opt/dwbridge-kit
COPY tools/dwbridge/Scripts /opt/dwbridge-kit/ue4ss/Mods/dwbridge/Scripts
COPY --from=shim /version.dll /opt/dwbridge-kit/version.dll

# ---- runtime ----
FROM docker.io/steamcmd/steamcmd:debian-12
COPY --from=build /out/wkagent /usr/local/bin/wkagent
COPY --from=kit /opt/dwbridge-kit /opt/dwbridge-kit

# Wine from WineHQ rather than Debian's: the feasibility run that proved
# UE4SS injects was on Wine 11, and Debian 12 ships far older. i386 is
# required even for a 64-bit game — the Wine packages depend on it.
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget gnupg \
    && wget -qO /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
    && wget -qNP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/debian/dists/bookworm/winehq-bookworm.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends winehq-stable \
    && apt-get purge -y gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Same non-root rule as the plain image: the game refuses to boot as root.
RUN useradd -m -u 1000 wkagent
USER wkagent
ENV HOME=/home/wkagent \
    WKAGENT_INSTALL_DIR=/dragonwilds \
    WKAGENT_STEAMCMD=steamcmd \
    WKAGENT_ADDR=:8811 \
    # The default this image exists for. It is only the *initial* selection:
    # a choice already persisted in the install volume wins, so redeploying
    # never silently changes which build a server runs.
    WKAGENT_LAUNCH_PROFILE=wine \
    # On the volume, so the prefix survives container recreation. Wine
    # rebuilds a missing prefix on first run, which is slow and would
    # otherwise happen on every deploy.
    WKAGENT_WINE_PREFIX=/dragonwilds/.wine \
    # Where /v1/bridge/install copies the UE4SS kit from. The plain image
    # leaves this unset, so the verb honestly answers "no kit in this image".
    WKAGENT_BRIDGE_KIT_DIR=/opt/dwbridge-kit \
    # A headless server has no display, and Wine's chatter would otherwise
    # interleave with the game log the player list is parsed from.
    WINEDEBUG=-all
EXPOSE 8811 7777/udp 7778/udp
HEALTHCHECK --interval=30s --timeout=5s \
    CMD ["/usr/local/bin/wkagent", "-healthz"]
ENTRYPOINT ["/usr/local/bin/wkagent"]
